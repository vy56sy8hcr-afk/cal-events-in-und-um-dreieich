 "_hinweis": "datum = Seiten mit festem Satz, aus dem das Datum eines bekannten Termins gelesen wird (korrigiert den Termin automatisch). beobachten = Presse- und Kalenderseiten, aus denen nur Vorschlaege in vorschlaege.txt entstehen (kommen nie automatisch in den Kalender). grossstaedte = hier kommen Adressen fuer Frankfurt, Bad Homburg, Oberursel, Hanau, Darmstadt, Mainz hinein. offen_adresse_fehlt = noch keine funktionierende Adresse.",
 "datum": [
  {
   "key": "langener-markt-{jahr}",
   "typ": "einzeltag",
   "url": "https://www.gewerbeverein-langen.de/verkaufsoffener-sonntag/",
   "muster": "Langener Markt findet am (\\d{1,2})\\. ([A-Za-zäöüÄÖÜ]+) (\\d{4})"
  },
  {
   "key": "laternenfest-bad-homburg-{jahr}",
   "typ": "zeitraum_num",
   "url": "https://laternenfest.de/",
   "muster": "Laternenfest\\s+\\d{4}\\W{0,4}\\s*(\\d{2})\\.(\\d{2})\\.\\s*bis\\s*(\\d{2})\\.(\\d{2})\\.(\\d{4})"
  },
  {
   "key": "brunnenfest-oberursel-{jahr}",
   "typ": "zeitraum",
   "url": "https://www.vereinsring-oberursel.de/brunnenfest/",
   "muster": "Brunnenfest.{0,120}?vom\\s+(\\d{1,2})\\.\\s*bis\\s*(\\d{1,2})\\.\\s*([A-Za-zäöüÄÖÜ]+)\\s+(\\d{4})"
  },
  {
   "key": "johannisnacht-mainz-{jahr}",
   "typ": "zeitraum",
   "url": "https://www.mainzer-johannisnacht.de/",
   "muster": "Johannisnacht.{0,120}?(\\d{1,2})\\.\\s*(?:bis|-|–)\\s*(\\d{1,2})\\.\\s*(Juni)\\s+(\\d{4})"
  }
 ],
